<!doctype html>
<html lang="{{HTML_LANG}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{TITLE}}</title>
  <meta name="description" content="{{DESCRIPTION}}">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <link rel="canonical" href="{{CANONICAL}}">
  <link rel="alternate" hreflang="ru" href="{{HREFLANG_RU}}">
  <link rel="alternate" hreflang="en" href="{{HREFLANG_EN}}">
  <link rel="alternate" hreflang="zh-CN" href="{{HREFLANG_CN}}">
  <link rel="alternate" hreflang="x-default" href="{{HREFLANG_RU}}">
  <link rel="stylesheet" href="/assets/style.css?v=topic-hub">
  <meta property="og:site_name" content="IndexResearch">
  <meta property="og:locale" content="{{OG_LOCALE}}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{TITLE}}">
  <meta property="og:description" content="{{DESCRIPTION}}">
  <meta property="og:url" content="{{CANONICAL}}">
  <meta property="og:image" content="https://indexresearch.ru/assets/indexresearch-logo-horizontal.png">
  <meta property="og:image:alt" content="IndexResearch">
  <script type="application/ld+json">
{{JSON_LD}}
  </script>
  <!-- IndexResearch favicons -->
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/assets/indexresearch-shield.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#0E3455">
  <meta name="msapplication-TileColor" content="#ffffff">
  <meta name="msapplication-TileImage" content="/mstile-150x150.png">
  <!-- /IndexResearch favicons -->
  <script src="/assets/analytics.js" defer></script>
</head>
<body>
<!-- Yandex.Metrika noscript fallback -->
<noscript><div><img src="https://mc.yandex.ru/watch/112773213" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
{{SITE_HEADER}}
<main>
<section class="hero small"><div class="wrap">
  <nav class="breadcrumbs" aria-label="{{BREADCRUMBS_ARIA}}"><a href="{{HOME_HREF}}">{{HOME_LABEL}}</a><span aria-hidden="true">/</span><a href="{{RATINGS_HREF}}">{{RESEARCH_LABEL}}</a><span aria-hidden="true">/</span><span aria-current="page">{{H1}}</span></nav>
  <p class="kicker">{{TOPIC_KICKER}}</p>
  <h1>{{H1}}</h1>
  <p class="lead">{{LEAD}}</p>
</div></section>
<section class="section"><div class="wrap">
  <h2>{{RESEARCH_IN_TOPIC_H2}}</h2>
  <p class="note topic-hub-intro">{{INTRO}}</p>
  <div class="grid topic-hub-grid" data-topic-hub="{{TOPIC_ID}}">
{{CARDS}}
  </div>
</div></section>
<section class="section alt"><div class="wrap">
  <h2>{{FULL_CATALOG_H2}}</h2>
  <p>{{FULL_CATALOG_TEXT}}</p>
  <p><a class="button" href="{{RATINGS_HREF}}">{{FULL_CATALOG_BUTTON}}</a></p>
</div></section>
</main>
{{SITE_FOOTER}}
</body>
</html>
